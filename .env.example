# 从本文件复制为 .env 后填写；也可在网页侧栏临时输入 API Key。
DASHSCOPE_API_KEY=

# 默认北京地域；API Key 必须来自同一地域。
# 支持控制台的业务空间专属地址，例如：
# https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# 网页和 FastAPI 共用以下默认配置；网页临时调整只影响当前会话。
RAG_RELEVANCE_THRESHOLD=0.35
RAG_TOP_K=5
# 留空或不设置时使用项目 data/chroma。
# CHROMA_PERSIST_DIRECTORY=D:/Environment/DeskTop/RAG/data/chroma
# 相对路径以项目目录为基准，与启动时所在的目录无关。

# FAQ：未在FAQ页面保存设置时采用以下默认值；页面保存后网页/API共用。
# 0.70表示70分语义门槛，BM25关键词分数不能绕过该门槛。
FAQ_MATCH_THRESHOLD=0.70
FAQ_MIN_MARGIN=0.08

# 语音输入：先使用百炼，后续可以切换为实验室 HTTP 服务。
ASR_PROVIDER=bailian
ASR_MODEL=qwen3-asr-flash
# 未设置独立值时，复用上面的百炼 Key 和调用地址。
# ASR_API_KEY=
# ASR_BASE_URL=

# 实验室服务协议：POST multipart file，返回 {"text": "识别结果"}。
# 使用时将 ASR_PROVIDER 改为 http，并填写实际地址。
ASR_HTTP_URL=http://127.0.0.1:9000/transcribe
# ASR_HTTP_API_KEY=
